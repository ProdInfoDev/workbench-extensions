        "events": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_-]+)+$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "visibility": {
                "default": "private",
                "type": "string",
                "enum": [
                  "public",
                  "private"
                ]
              },
              "subscribe": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "notification": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 90
