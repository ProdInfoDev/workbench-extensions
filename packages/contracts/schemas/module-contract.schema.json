              "title",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "roles": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
