            "additionalProperties": false
          }
        },
        "commands": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_-]+)+$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "visibility": {
                "default": "private",
