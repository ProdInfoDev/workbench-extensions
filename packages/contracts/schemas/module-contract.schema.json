                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_-]+)+$"
              },
              "route": {
                "type": "string",
                "pattern": "^\\/[a-z0-9/_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "navGroup": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "requiredCapabilities": {
