          "run": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "needs": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "required": [
          "id",
          "run",
          "needs"
        ],
        "additionalProperties": false
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "screens": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_-]+)+$"
              },
              "route": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^\\/[a-zA-Z0-9:_/-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "navGroup": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "hidden": {
                "type": "boolean"
              },
              "requiredCapabilities": {
                "default": [],
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_.:-]{1,80}$"
                }
              }
            },
            "required": [
