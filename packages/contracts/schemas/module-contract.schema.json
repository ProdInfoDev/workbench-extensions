          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "permissions": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_.:-]{1,80}$"
                }
              }
            },
            "required": [
              "title",
              "permissions"
            ],
            "additionalProperties": false
          }
        },
        "viewer": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "permissions": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_.:-]{1,80}$"
                }
              }
            },
            "required": [
              "title",
              "permissions"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "member",
        "viewer"
      ],
      "additionalProperties": false
    },
