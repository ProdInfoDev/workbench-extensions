          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_-]+)+$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "read": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "write": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "ai": {
                "type": "string",
                "enum": [
                  "auto",
                  "confirm",
                  "never"
                ]
              }
            },
            "required": [
              "read"
            ],
            "additionalProperties": false
          }
