                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warning",
                      "critical"
                    ]
                  },
                  "payloadSchema": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "title",
                  "severity"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "visibility",
              "subscribe"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "permissions",
        "roles",
        "commands",
        "views",
        "tables",
        "events"
      ],
      "additionalProperties": false
    },
    "routines": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_-]+)+$"
