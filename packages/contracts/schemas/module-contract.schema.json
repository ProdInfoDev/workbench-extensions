                  "read",
                  "configure",
                  "createArtifact",
                  "submit",
                  "controlRun"
                ]
              },
              "call": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "ai": {
                "type": "string",
                "enum": [
                  "auto",
                  "confirm",
                  "never"
                ]
              }
            },
            "required": [
              "visibility",
              "effect",
              "call"
            ],
            "additionalProperties": false
          }
        },
        "views": {
          "default": {},
