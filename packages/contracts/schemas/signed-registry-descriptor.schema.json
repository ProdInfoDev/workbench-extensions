{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "descriptor": {
      "type": "object",
      "properties": {
        "moduleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "stable",
            "beta"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "listed",
            "unlisted",
            "yanked"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "replacementVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "requiredCoreRange": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dependencies": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "moduleId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "versionRange": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "moduleId",
              "versionRange"
            ],
            "additionalProperties": false
          }
        },
        "migrationSteps": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}_[a-z][a-z0-9_-]*\\.sql$"
          }
        }
      },
      "required": [
        "moduleId",
        "version",
        "packageDigest",
        "channel",
        "state",
        "contractVersion",
        "requiredCoreRange",
        "dependencies",
        "migrationSteps"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "descriptor",
    "signature"
  ],
  "additionalProperties": false
}
